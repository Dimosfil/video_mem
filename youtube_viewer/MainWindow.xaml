<Window x:Class="YouTubeViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Viewer"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BrowserChrome"
                Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="7,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource ChromeButton}"
                        Content="←"
                        ToolTip="Назад (Alt+←)"
                        IsEnabled="False"
                        Click="BackButton_Click" />
                <Button x:Name="ForwardButton"
                        Grid.Column="1"
                        Style="{StaticResource ChromeButton}"
                        Content="→"
                        ToolTip="Вперёд (Alt+→)"
                        IsEnabled="False"
                        Click="ForwardButton_Click" />
                <Button x:Name="ReloadButton"
                        Grid.Column="2"
                        Style="{StaticResource ChromeButton}"
                        Content="↻"
                        ToolTip="Обновить (F5)"
                        IsEnabled="False"
                        Click="ReloadButton_Click" />
                <Button x:Name="HomeButton"
                        Grid.Column="3"
                        Style="{StaticResource ChromeButton}"
                        Content="⌂"
                        ToolTip="YouTube"
                        IsEnabled="False"
                        Click="HomeButton_Click" />

                <Border Grid.Column="4"
                        Height="34"
                        Margin="8,0"
                        Background="{StaticResource ControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBox x:Name="AddressBox"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             Padding="11,6"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             ToolTip="Адрес YouTube или поисковый запрос (Ctrl+L)"
                             IsEnabled="False"
                             KeyDown="AddressBox_KeyDown" />
                </Border>

                <Button x:Name="GoButton"
                        Grid.Column="5"
                        Style="{StaticResource ChromeButton}"
                        Content="➜"
                        ToolTip="Перейти"
                        IsEnabled="False"
                        Click="GoButton_Click" />
                <Button x:Name="NewTabButton"
                        Grid.Column="6"
                        Style="{StaticResource ChromeButton}"
                        Content="+"
                        FontSize="24"
                        ToolTip="Новая вкладка (Ctrl+T)"
                        IsEnabled="False"
                        Click="NewTabButton_Click" />
            </Grid>
        </Border>

        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="#FF0033"
                     Background="Transparent"
                     Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <TabControl x:Name="Tabs"
                        Background="{StaticResource AppBackgroundBrush}"
                        BorderThickness="0"
                        SelectionChanged="Tabs_SelectionChanged" />
            <StackPanel x:Name="StartupPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="YouTube Viewer"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StartupText"
                           Text="Проверка подключения к Happ…"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border x:Name="StatusPanel"
                Grid.Row="3"
                Background="{StaticResource ChromeBrush}"
                Padding="10,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
