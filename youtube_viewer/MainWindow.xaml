<Window x:Class="YouTubeViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YouTubeViewer"
        Title="YouTube Viewer"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="TabContextMenu" x:Shared="False">
            <MenuItem Header="Дублировать вкладку" Tag="Duplicate" Click="DuplicateTabMenu_Click" />
            <Separator />
            <MenuItem Header="Закрыть вкладку" InputGestureText="Ctrl+W"
                      Tag="{x:Static local:TabCloseScope.Current}" Click="CloseTabsMenu_Click" />
            <MenuItem Header="Закрыть остальные вкладки"
                      Tag="{x:Static local:TabCloseScope.Others}" Click="CloseTabsMenu_Click" />
            <MenuItem Header="Закрыть вкладки слева"
                      Tag="{x:Static local:TabCloseScope.Left}" Click="CloseTabsMenu_Click" />
            <MenuItem Header="Закрыть вкладки справа"
                      Tag="{x:Static local:TabCloseScope.Right}" Click="CloseTabsMenu_Click" />
            <Separator />
            <MenuItem Header="Закрыть все вкладки"
                      Tag="{x:Static local:TabCloseScope.All}" Click="CloseTabsMenu_Click" />
            <Separator />
            <MenuItem Header="Восстановить закрытую вкладку" InputGestureText="Ctrl+Shift+T"
                      Click="ReopenTabMenu_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BrowserChrome"
                Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="7,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource ChromeButton}"
                        Content="←"
                        ToolTip="Назад (Alt+←)"
                        IsEnabled="False"
                        Click="BackButton_Click" />
                <Button x:Name="ForwardButton"
                        Grid.Column="1"
                        Style="{StaticResource ChromeButton}"
                        Content="→"
                        ToolTip="Вперёд (Alt+→)"
                        IsEnabled="False"
                        Click="ForwardButton_Click" />
                <Button x:Name="ReloadButton"
                        Grid.Column="2"
                        Style="{StaticResource ChromeButton}"
                        Content="↻"
                        ToolTip="Обновить (F5)"
                        IsEnabled="False"
                        Click="ReloadButton_Click" />
                <Button x:Name="HomeButton"
                        Grid.Column="3"
                        Style="{StaticResource ChromeButton}"
                        Content="⌂"
                        ToolTip="YouTube"
                        IsEnabled="False"
                        Click="HomeButton_Click" />

                <Border Grid.Column="4"
                        Height="34"
                        Margin="8,0"
                        Background="{StaticResource ControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBox x:Name="AddressBox"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0"
                             Padding="11,6"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             ToolTip="Адрес YouTube или поисковый запрос (Ctrl+L)"
                             IsEnabled="False"
                             KeyDown="AddressBox_KeyDown" />
                </Border>

                <Button x:Name="GoButton"
                        Grid.Column="5"
                        Style="{StaticResource ChromeButton}"
                        Content="➜"
                        ToolTip="Перейти"
                        IsEnabled="False"
                        Click="GoButton_Click" />
                <Button x:Name="SettingsButton"
                        Grid.Column="6"
                        Style="{StaticResource ChromeButton}"
                        Content="⚙"
                        FontSize="17"
                        ToolTip="Настройки подключения"
                        Click="SettingsButton_Click" />
                <Button x:Name="AdBlockButton" Grid.Column="7" Margin="6,0,0,0"
                        Padding="8,4" Content="Реклама: …" IsEnabled="False"
                        ToolTip="Подготовка блокировки рекламы"
                        Click="AdBlockButton_Click" />
            </Grid>
        </Border>

        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="#FF0033"
                     Background="Transparent"
                     Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <TabControl x:Name="Tabs"
                        Background="{StaticResource AppBackgroundBrush}"
                        BorderThickness="0"
                        IsEnabled="False"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </ScrollViewer>
                                <Button x:Name="NewTabButton" Grid.Column="1"
                                        Style="{StaticResource ChromeButton}"
                                        Content="+" FontSize="24" Margin="4,2,4,0"
                                        VerticalAlignment="Top"
                                        ToolTip="Новая вкладка (Ctrl+T)"
                                        AutomationProperties.Name="Новая вкладка"
                                        Click="NewTabButton_Click" />
                            </Grid>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
            </TabControl>
            <StackPanel x:Name="StartupPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="YouTube Viewer"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StartupText"
                           Text="Подготовка подключения…"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <Border x:Name="BrowserErrorPanel"
                    Visibility="Collapsed" MaxWidth="520" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource ChromeBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Не удалось загрузить страницу" FontSize="20" Margin="0,0,0,12" />
                    <TextBlock x:Name="BrowserErrorText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Повторить загрузку" Padding="12,8" Click="ReloadButton_Click" />
                        <Button Content="Настройки подключения" Padding="12,8" Margin="10,0,0,0" Click="SettingsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusPanel"
                Grid.Row="3"
                Background="{StaticResource ChromeBrush}"
                Padding="10,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
