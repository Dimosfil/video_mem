<Window x:Class="YouTubeViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки подключения"
        Width="560"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Маршрутизация трафика"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,18,0,10"
                Padding="14"
                Background="{StaticResource ControlBrush}"
                CornerRadius="8">
            <StackPanel>
                <RadioButton x:Name="SystemRouteRadio"
                             GroupName="RoutingMode"
                             Content="Системное подключение / общий VPN"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Checked="RoutingMode_Checked" />
                <TextBlock Margin="24,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Без привязки к конкретному VPN. Подходит для обычного интернета, системного VPN и режима, в котором через VPN идут все приложения." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                Background="{StaticResource ControlBrush}"
                CornerRadius="8">
            <StackPanel>
                <RadioButton x:Name="LocalProxyRadio"
                             GroupName="RoutingMode"
                             Content="Локальный HTTP-прокси"
                             Foreground="{StaticResource TextBrush}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Checked="RoutingMode_Checked" />
                <TextBlock Margin="24,7,0,8"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Для раздельной маршрутизации через любой VPN-клиент, предоставляющий локальный HTTP-прокси." />
                <TextBox x:Name="ProxyUrlBox"
                         Margin="24,0,0,0"
                         Height="32"
                         Padding="8,5"
                         Background="#181818"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         ToolTip="Например: http://127.0.0.1:10809" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="При выборе локального прокси приложение не подключается напрямую, если прокси недоступен." />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="95"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Width="105"
                    Height="34"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
