# Copy to .env for local bot development. Never commit real tokens.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-token

VIDEO_BOT_DATA_DIR=data/video-bot
VIDEO_BOT_MAX_CLIP_SECONDS=180
VIDEO_BOT_MAX_UPLOAD_BYTES=50000000
VIDEO_BOT_WORKERS=2
VIDEO_BOT_JOB_TTL_HOURS=24
VIDEO_BOT_MEDIA_TIMEOUT_SECONDS=1800

# Optional Netscape-format cookies file for restricted YouTube videos.
# In Docker, place it under ./data and use /app/data/<filename> here.
YTDLP_COOKIE_FILE=
# Optional explicit FFmpeg executable. Otherwise PATH is used.
FFMPEG_EXECUTABLE=
